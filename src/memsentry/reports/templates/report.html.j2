<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MemSentry Report - {{ report.case.case_number }}</title>
    <style>
        :root {
            --bg-color: #f8f9fa;
            --text-color: #212529;
            --container-bg: #ffffff;
            --border-color: #dee2e6;
            --header-bg: #e9ecef;
            --accent-color: #0d6efd;
            --severity-high: #dc3545;
            --severity-medium: #fd7e14;
            --severity-low: #ffc107;
            --severity-info: #0dcaf0;
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --bg-color: #212529;
                --text-color: #f8f9fa;
                --container-bg: #343a40;
                --border-color: #495057;
                --header-bg: #495057;
                --accent-color: #0d6efd;
                --severity-high: #ea868f;
                --severity-medium: #feb272;
                --severity-low: #ffda6a;
                --severity-info: #6edff6;
            }
        }

        body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.5;
            margin: 0;
            padding: 2rem;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background-color: var(--container-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 2rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        h1, h2, h3, h4 {
            margin-top: 0;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 0.5rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1.5rem;
        }

        th, td {
            padding: 0.75rem;
            border: 1px solid var(--border-color);
            text-align: left;
        }

        th {
            background-color: var(--header-bg);
            font-weight: 600;
        }

        .section {
            margin-bottom: 2.5rem;
        }

        .badge {
            display: inline-block;
            padding: 0.25em 0.4em;
            font-size: 0.75em;
            font-weight: 700;
            line-height: 1;
            text-align: center;
            white-space: nowrap;
            vertical-align: baseline;
            border-radius: 0.25rem;
            color: #fff;
        }

        .severity-high { background-color: var(--severity-high); color: #000; }
        .severity-medium { background-color: var(--severity-medium); color: #000; }
        .severity-low { background-color: var(--severity-low); color: #000; }
        .severity-info { background-color: var(--severity-info); color: #000; }

        pre {
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            padding: 1rem;
            border-radius: 4px;
            overflow-x: auto;
        }

        .timestamp {
            font-size: 0.85em;
            color: #6c757d;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>MemSentry Forensic Report</h1>
        <p class="timestamp">Generated at: {{ report.generated_at }}</p>

        <div class="section">
            <h2>Case Summary</h2>
            <table>
                <tr>
                    <th>Case Number</th>
                    <td>{{ report.case.case_number }}</td>
                </tr>
                <tr>
                    <th>Name</th>
                    <td>{{ report.case.name }}</td>
                </tr>
                <tr>
                    <th>Status</th>
                    <td>{{ report.case.status }}</td>
                </tr>
                <tr>
                    <th>Created</th>
                    <td>{{ report.case.created_at }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ report.case.description or 'N/A' }}</td>
                </tr>
            </table>
        </div>

        <div class="section">
            <h2>Evidence & Integrity</h2>
            {% if report.evidences %}
                {% for evidence in report.evidences %}
                <table>
                    <tr>
                        <th>Filename</th>
                        <td>{{ evidence.original_filename }}</td>
                    </tr>
                    <tr>
                        <th>Path</th>
                        <td>{{ evidence.file_path }}</td>
                    </tr>
                    <tr>
                        <th>Size (bytes)</th>
                        <td>{{ evidence.file_size_bytes }}</td>
                    </tr>
                    <tr>
                        <th>OS</th>
                        <td>{{ evidence.evidence_os or 'Unknown' }}</td>
                    </tr>
                    <tr>
                        <th>SHA-256</th>
                        <td><pre style="margin: 0; padding: 0.25rem; display: inline-block;">{{ evidence.sha256 }}</pre></td>
                    </tr>
                    <tr>
                        <th>Integrity Status</th>
                        <td>{{ evidence.integrity_status }}</td>
                    </tr>
                </table>
                {% endfor %}
            {% else %}
                <p>No evidence registered.</p>
            {% endif %}
        </div>

        <div class="section">
            <h2>Findings Summary</h2>
            {% if report.findings %}
                <table>
                    <thead>
                        <tr>
                            <th>Severity</th>
                            <th>Title</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for finding in report.findings %}
                        <tr>
                            <td><span class="badge severity-{{ finding.severity.lower() }}">{{ finding.severity }}</span></td>
                            <td>{{ finding.title }}</td>
                            <td>{{ finding.description }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                
                <h3>Finding Details</h3>
                {% for finding in report.findings %}
                    <div style="border: 1px solid var(--border-color); padding: 1rem; margin-bottom: 1rem; border-radius: 4px;">
                        <h4>{{ finding.title }} <span class="badge severity-{{ finding.severity.lower() }}">{{ finding.severity }}</span></h4>
                        <p><strong>Description:</strong> {{ finding.description }}</p>
                        {% if finding.details %}
                        <p><strong>Details:</strong></p>
                        <pre>{{ finding.details }}</pre>
                        {% endif %}
                    </div>
                {% endfor %}
            {% else %}
                <p>No findings recorded.</p>
            {% endif %}
        </div>

        {% if report.plugin_runs is not none %}
        <div class="section">
            <h2>Plugin Execution Summary</h2>
            {% if report.plugin_runs %}
                <table>
                    <thead>
                        <tr>
                            <th>Plugin</th>
                            <th>Status</th>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th>Error</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for run in report.plugin_runs %}
                        <tr>
                            <td>{{ run.plugin_name }}</td>
                            <td>{{ run.status }}</td>
                            <td>{{ run.started_at }}</td>
                            <td>{{ run.completed_at or 'N/A' }}</td>
                            <td>{{ run.error_message or 'N/A' }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p>No plugin runs recorded.</p>
            {% endif %}
        </div>
        {% endif %}

        {% if report.artifacts is not none %}
        <div class="section">
            <h2>Artifacts</h2>
            {% if report.artifacts %}
                {% for artifact in report.artifacts %}
                    <h3>Artifact: {{ artifact.artifact_type }}</h3>
                    <p class="timestamp">Created: {{ artifact.created_at }}</p>
                    <pre>{{ artifact.original_data }}</pre>
                {% endfor %}
            {% else %}
                <p>No artifacts included.</p>
            {% endif %}
        </div>
        {% endif %}

        {% if report.workflow_events is not none %}
        <div class="section">
            <h2>Workflow & Audit History</h2>
            {% if report.workflow_events %}
                <table>
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Stage</th>
                            <th>Phase</th>
                            <th>Status</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for event in report.workflow_events %}
                        <tr>
                            <td>{{ event.created_at }}</td>
                            <td>{{ event.stage }}</td>
                            <td>{{ event.phase }}</td>
                            <td>{{ event.status }}</td>
                            <td>{{ event.message or '' }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p>No workflow events recorded.</p>
            {% endif %}
        </div>
        {% endif %}

    </div>
</body>
</html>
